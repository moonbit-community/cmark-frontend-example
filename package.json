{
  "name": "cmark-bench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "prebumpCmark": "moon -C cmarkwrap build --release --no-strip --target=wasm-gc",
    "bumpCmark": "cp cmarkwrap/target/wasm-gc/release/build/lib/lib.wasm assets/cmark.wasm && wasm-tools strip assets/cmark.wasm | wasm-opt --all-features -o assets/cmarkopt.wasm -g --converge --gufa --generate-global-effects -O4 --monomorphize -O4 --flatten --flatten --rereloop -Oz -Oz -tnh -O4"
  },
  "dependencies": {
    "bowser": "^2.11.0",
    "comlink": "^4.4.2",
    "micromark": "^4.0.1",
    "microtime": "^3.1.1",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "tinybench": "^3.1.0",
    "unified": "^11.0.5",
    "vue": "^3.5.13",
    "vuejs-smart-table": "1.0.0-beta.6"
  },
  "devDependencies": {
    "@types/commonmark": "^0.27.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-perfectionist": "^4.1.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.31.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.16.0",
    "vite": "^6.0.1",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.10"
  }
}
